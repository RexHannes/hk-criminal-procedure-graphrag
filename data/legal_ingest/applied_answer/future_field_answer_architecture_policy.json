      "answer_first_validator": "scripts/validate_legal_rag_answer_first_api.js",
      "source_card_validator": "scripts/validate_part1_two_vertical_source_cards.js",
      "golden_query_validator": "scripts/validate_probate_inquiry_api.js",
      "scope_boundary": "statute_led_no_probate_case_digest_until_public_paragraph_authority_verified"
    },
    {
      "domain": "criminal_law",
      "scenario": "theft_property_dishonesty",
