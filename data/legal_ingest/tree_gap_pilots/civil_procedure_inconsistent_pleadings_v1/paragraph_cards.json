  "paragraph_cards": [
    {
      "paragraph_id": "hk_case_2020_minloy_p31",
      "case_id": "hk_case_2020_minloy",
      "paragraph_no": "31",
      "text": "The principle is not confined to inconsistent factual allegations but applies to inconsistent positions or assumptions adopted by a party in different proceedings. The mischief to which the principle is directed is to prevent a litigant from adopting inconsistent positions on the same issue in different proceedings.",
      "chunk_hash": "754976c85fbecd035ad01314a21d9c83dc88b13182a7bf4a6d06ce7de12fce1a",
      "source_url": "https://www.hklii.hk/en/cases/hkcfi/2020/2215",
      "source_visibility": "public_demo",
      "tenant_id": "public",
      "fixture_status": "real_public_source_tree_gap_pilot",
      "authority_status": "verified_public_authority"
    },
    {
      "paragraph_id": "hk_case_2022_lancom_capxon_p43",
      "case_id": "hk_case_2022_lancom_capxon",
      "paragraph_no": "43",
      "text": "It is an abuse of process for a party to adopt a position which is inconsistent and incompatible with the position he adopted in previous proceedings, and the party would be estopped from doing so.",
      "chunk_hash": "6e1c6eae720cee939bfaf262f1827d8a25b78a61f9b3e09e9ead4c56ba5cd406",
      "source_url": "https://www.hklii.hk/en/cases/hkcfi/2022/381",
      "source_visibility": "public_demo",
      "tenant_id": "public",
      "fixture_status": "real_public_source_tree_gap_pilot",
      "authority_status": "verified_public_authority"
    },
    {
      "paragraph_id": "hk_case_2025_vasily_trubnikov_p39",
      "case_id": "hk_case_2025_vasily_trubnikov",
      "paragraph_no": "39",
      "text": "It may be an abuse of process for a party, with full knowledge of the facts, to advance a claim that is diametrically opposed to its position taken in an earlier set of proceedings. The abuse lies in its effect on the integrity of the administration of justice.",
      "chunk_hash": "428c3ca50ec30dbb0177f24199c0ec335f741c6098cf033b02ce36f7644d62a9",
      "source_url": "https://www.hklii.hk/en/cases/hkcfi/2025/1576",
      "source_visibility": "public_demo",
      "tenant_id": "public",
      "fixture_status": "real_public_source_tree_gap_pilot",
      "authority_status": "verified_public_authority"
    },
    {
      "paragraph_id": "hk_case_2023_liu_hao_tsing_p16",
      "case_id": "hk_case_2023_liu_hao_tsing",
      "paragraph_no": "16",
      "text": "If the matters pleaded are matters which are plainly within that party's knowledge, so that he must know which of the inconsistent alternatives is the correct one, then the pleading of inconsistent alternative cases is not permissible.",
      "chunk_hash": "ae9580d86f8dd62fe487e127c89c38b8ca6699da9e3065dd7b053be848237387",
      "source_url": "https://www.hklii.hk/en/cases/hkcfi/2023/1463",
      "source_visibility": "public_demo",
      "tenant_id": "public",
      "fixture_status": "real_public_source_tree_gap_pilot",
      "authority_status": "verified_public_authority"
    },
    {
      "paragraph_id": "hk_case_2019_shinyei_jenus_p19",
      "case_id": "hk_case_2019_shinyei_jenus",
      "paragraph_no": "19",
      "text": "Where the assertions in the plaintiff's affirmation constitute a material deviation from the plaintiff's pleaded case, the plaintiff will have failed to verify his claim as pleaded, and summary judgment should not be granted.",
      "chunk_hash": "a6d52eae57ce1502146be3fe4a70e03ecc1e1addfdba361707c143511a588b4d",
      "source_url": "https://www.hklii.hk/en/cases/hkcfi/2019/2377",
      "source_visibility": "public_demo",
      "tenant_id": "public",
      "fixture_status": "real_public_source_tree_gap_pilot",
      "authority_status": "verified_public_authority"
    }
