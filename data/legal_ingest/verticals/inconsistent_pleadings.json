  "legal_paragraphs": [
    {
      "paragraph_id": "hk_case_2020_minloy_p31",
      "source_id": "hk_case_2020_minloy",
      "para_no": "31",
      "pinpoint": "para 31",
      "citation": "[2020] HKCFI 2215",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["abuse_of_process", "inconsistent_positions", "estoppel"],
      "visibility": "public_source",
      "verification_status": "quote_verified",
      "answer_layer_status": "research_only",
      "paragraph_text": "The principle is not confined to inconsistent factual allegations but applies to inconsistent positions or assumptions adopted by a party in different proceedings. The mischief to which the principle is directed is to prevent a litigant from adopting inconsistent positions on the same issue in different proceedings."
    },
    {
      "paragraph_id": "hk_case_2022_lancom_capxon_p43",
      "source_id": "hk_case_2022_lancom_capxon",
      "para_no": "43",
      "pinpoint": "para 43",
      "citation": "[2022] HKCFI 381",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["abuse_of_process", "estoppel", "inconsistent_positions"],
      "visibility": "public_source",
      "verification_status": "quote_verified",
      "answer_layer_status": "research_only",
      "paragraph_text": "It is an abuse of process for a party to adopt a position which is inconsistent and incompatible with the position he adopted in previous proceedings, and the party would be estopped from doing so."
    },
    {
      "paragraph_id": "hk_case_2025_vasily_trubnikov_p39",
      "source_id": "hk_case_2025_vasily_trubnikov",
      "para_no": "39",
      "pinpoint": "para 39",
      "citation": "[2025] HKCFI 1576",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["abuse_of_process", "diametrically_opposed_positions", "integrity_of_justice"],
      "visibility": "public_source",
      "verification_status": "quote_verified",
      "answer_layer_status": "research_only",
      "paragraph_text": "It may be an abuse of process for a party, with full knowledge of the facts, to advance a claim that is diametrically opposed to its position taken in an earlier set of proceedings. The abuse lies in its effect on the integrity of the administration of justice."
    },
    {
      "paragraph_id": "hk_case_2023_liu_hao_tsing_p16",
      "source_id": "hk_case_2023_liu_hao_tsing",
      "para_no": "16",
      "pinpoint": "para 16",
      "citation": "[2023] HKCFI 1463",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["alternative_pleading", "party_knowledge", "inconsistent_cases"],
      "visibility": "public_source",
      "verification_status": "quote_verified",
      "answer_layer_status": "research_only",
      "paragraph_text": "If the matters pleaded are matters which are plainly within that party's knowledge, so that he must know which of the inconsistent alternatives is the correct one, then the pleading of inconsistent alternative cases is not permissible."
    },
    {
      "paragraph_id": "hk_case_2019_shinyei_jenus_p19",
      "source_id": "hk_case_2019_shinyei_jenus",
      "para_no": "19",
      "pinpoint": "para 19",
      "citation": "[2019] HKCFI 2377",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["summary_judgment", "pleaded_case", "material_deviation"],
      "visibility": "public_source",
      "verification_status": "quote_verified",
      "answer_layer_status": "research_only",
      "paragraph_text": "Where the assertions in the plaintiff's affirmation constitute a material deviation from the plaintiff's pleaded case, the plaintiff will have failed to verify his claim as pleaded, and summary judgment should not be granted."
    },
    {
      "paragraph_id": "hk_case_2025_dp_world_djibouti_henderson",
      "source_id": "hk_case_2025_dp_world_djibouti",
      "para_no": "pending_full_pinpoint",
      "pinpoint": "pinpoint pending full judgment check",
      "citation": "[2025] HKCFI 3861",
      "court": "CFI",
      "jurisdiction": "Hong Kong",
      "issue_tags": ["henderson_abuse", "duplicative_litigation", "should_have_been_raised"],
      "visibility": "public_source",
      "verification_status": "machine_candidate",
      "answer_layer_status": "research_only",
      "paragraph_text": "Henderson-type abuse concerns matters which could and should have been raised in earlier proceedings. Pinpoint verification is required before this card may support a final legal proposition."
    }
  ],
