    {
      "l5_proof_id": "l5_prop_lai_cfi_2022_jr_bound_to_fail_p26",
      "proposition_id": "prop_lai_cfi_2022_jr_bound_to_fail_p26",
      "case_id": "hk_cfi_2022_lai_chee_ying_hcmp_1218_hcal_738",
