      "substance_order": ["pi_common_parties_capacity", "workplace_status_and_task", "employer_primary_duty", "statutory_or_safety_system", "causation", "pi_common_injury_quantum", "pi_common_review_gate"],
      "specific_blocks": [
        {
          "block_id": "workplace_status_and_task",
