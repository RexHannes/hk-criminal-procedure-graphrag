{
  "domain_id": "tort_law_hk",
  "map_id": "pi_form_substance_map",
  "title": "Personal Injury Form Substance Map",
  "version": "0.1.0",
  "last_updated": "2026-06-14",
  "copyright_policy": "schema_and_issue_mapping_only_no_proprietary_precedent_text",
  "purpose": "Defines the substance each form family should collect and display. This is for routing, validation and lawyer-reviewed drafting; it does not reproduce court or precedent wording.",
  "common_substance_blocks": [
    {
      "block_id": "pi_common_parties_capacity",
      "label": "Parties, capacity and standing",
      "required_facts": ["plaintiff identity", "defendant identity", "capacity/representative status", "minor/protected party status", "estate/dependency status where applicable"],
      "verification_status": "needs_source_card_verification"
    },
    {
      "block_id": "pi_common_accident_core",
      "label": "Accident core facts",
      "required_facts": ["date", "time", "place", "mechanism", "witnesses", "photos/CCTV", "incident report"],
      "verification_status": "needs_source_card_verification"
    },
    {
      "block_id": "pi_common_liability_elements",
      "label": "Liability elements",
      "required_facts": ["duty basis", "breach particulars", "causation", "remoteness", "defence risks"],
      "linked_principle_nodes": ["tort_law_hk.pi.negligence.application"],
      "verification_status": "needs_source_card_verification"
    },
    {
      "block_id": "pi_common_injury_quantum",
      "label": "Injury and quantum facts",
      "required_facts": ["diagnosis", "treatment", "sick leave", "prognosis", "PSLA support", "special damages", "loss of earnings", "future loss"],
      "linked_principle_nodes": ["tort_law_hk.pi.quantum.router"],
      "verification_status": "needs_source_card_verification"
    },
    {
      "block_id": "pi_common_review_gate",
      "label": "Review gate",
      "required_facts": ["source status", "missing facts", "firm SOP status", "partner approval status"],
      "output_mode": "draft_only_lawyer_review_required",
      "verification_status": "needs_form_review"
    }
  ],
  "form_family_substance": [
    {
      "family_id": "accident_specific_particulars",
      "label": "Accident-specific Particulars of Claim",
