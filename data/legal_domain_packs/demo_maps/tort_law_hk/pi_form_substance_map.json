      "substance_order": ["pi_common_parties_capacity", "pi_common_accident_core", "occupiers_or_general_duty", "breach_particulars", "causation", "pi_common_injury_quantum", "pi_common_review_gate"],
      "specific_blocks": [
        {
          "block_id": "occupiers_or_general_duty",
          "label": "Occupiers / general duty basis",
          "required_facts": ["control of premises", "visitor status", "hazard", "warning", "inspection/cleaning/maintenance system"],
          "linked_principle_nodes": ["tort_law_hk.pi.occupiers.application"]
        },
        {
          "block_id": "breach_particulars",
          "label": "Breach particulars",
          "required_facts": ["failure to inspect", "failure to clean", "failure to warn", "unsafe condition", "contractor/stranger issue if raised"],
          "linked_principle_nodes": ["tort_law_hk.pi.breach.risk_precautions", "tort_law_hk.pi.occupiers.warning_inspection"]
        }
      ],
      "output_mode": "draft_only_lawyer_review_required"
