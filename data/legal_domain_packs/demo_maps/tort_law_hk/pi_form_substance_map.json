      "output_mode": "draft_only_lawyer_review_required"
    },
    {
      "family_id": "defence",
      "label": "PI Defences",
      "applies_to_forms": ["pi_form_defence_general", "pi_form_defence_occupiers", "pi_form_defence_rta", "pi_form_defence_workplace", "pi_form_defence_contributory_negligence_general", "pi_form_defence_seatbelt_or_helmet", "pi_form_defence_volenti", "pi_form_defence_pure_accident_inevitable_latent_defect", "pi_form_defence_independent_contractor_act_of_stranger", "pi_form_defence_not_occupier_trespasser_warning", "pi_form_defence_no_dependency_or_letters_admin", "pi_form_defence_psychiatric_secondary_victim"],
