  "rag_modules": [
    {
      "module_id": "matter_intake_router",
      "label": "Matter Intake Router",
      "routes": ["road_traffic", "workplace", "medical_negligence", "slip_fall", "assault", "fatal_accident", "minor", "other"],
      "outputs": ["accident_type", "court_band_candidate", "task_type", "missing_facts"],
      "gate": "intake_missing_facts_visible"
    },
    {
      "module_id": "principles_rag",
      "label": "Principles RAG",
      "uses": ["tort doctrine", "negligence elements", "causation/remoteness", "defences", "quantum heads", "limitation"],
      "answer_section": "principles"
    },
    {
      "module_id": "procedure_rag",
      "label": "Procedure / SOP RAG",
      "uses": ["PD18.1", "pre-action", "pleadings", "discovery", "expert reports", "checklist review", "CMC/PTR", "trial/assessment"],
      "answer_section": "procedures_forms"
    },
    {
      "module_id": "forms_rag",
      "label": "Forms RAG",
      "uses": ["CFI forms", "District Court forms", "PD18.1 annex templates", "employee compensation forms", "firm templates"],
      "answer_section": "procedures_forms"
    },
    {
      "module_id": "precedent_rag",
      "label": "Precedent RAG",
      "uses": ["statement of claim precedents", "damages schedules", "pre-action letters", "settlement templates", "firm drafting style"],
      "answer_section": "procedures_forms",
      "gate": "precedent_not_authority"
    },
    {
      "module_id": "verification_layer",
      "label": "Verification Layer",
      "uses": ["claim-source alignment", "form existence", "citation completeness", "source date/version", "conflict detection", "cannot verify fallback"],
      "answer_section": "governance"
    }
  ],
  "routing_rules": [
    {
      "rule_id": "principles_questions",
      "if_query_mentions": ["law", "test", "element", "defence", "duty", "breach", "causation", "quantum", "limitation"],
      "route_to": ["principles_rag", "verification_layer"],
      "must_not": "answer_from_llm_memory"
    },
    {
      "rule_id": "procedure_questions",
      "if_query_mentions": ["procedure", "steps", "SOP", "checklist", "CMC", "PTR", "pre-action", "discovery"],
      "route_to": ["procedure_rag", "verification_layer"],
      "source_priority": ["pd18_1_personal_injuries_list", "judiciary_practice_directions", "clic_personal_injuries"]
    },
    {
      "rule_id": "forms_questions",
      "if_query_mentions": ["form", "writ", "draft", "fill", "template", "statement of claim", "schedule of damages"],
      "route_to": ["forms_rag", "procedure_rag", "precedent_rag", "verification_layer"],
      "gate": "no_retrieved_form_no_draft"
    },
    {
      "rule_id": "workplace_overlay",
      "if_query_mentions": ["workplace", "employee", "employer", "work injury", "industrial accident", "occupational disease"],
      "route_to": ["principles_rag", "forms_rag", "employee_compensation_overlay", "verification_layer"],
      "warning": "Employees' compensation and common-law PI claim are distinct routes."
    },
    {
      "rule_id": "limitation_warning",
      "if_query_mentions": ["limitation", "deadline", "time limit", "out of time"],
      "route_to": ["principles_rag", "verification_layer"],
      "required_facts": ["accident date", "date of knowledge", "claimant age/disability", "fatal accident status"],
      "warning": "Verify urgently with solicitor."
    },
    {
      "rule_id": "court_band_warning",
      "if_query_mentions": ["court", "forum", "jurisdiction", "CFI", "District Court", "Small Claims", "claim value", "HK$"],
      "route_to": ["procedure_rag", "forms_rag", "verification_layer"],
      "required_facts": ["estimated claim value", "claim type", "parties", "current jurisdiction limit check"],
      "warning": "Court band is preliminary routing only; verify current jurisdiction before filing."
    }
  ],
  "verification_gates": [
    {
      "gate_id": "no_source_no_answer",
      "label": "No source, no legal answer",
      "rule": "Every legal claim must have at least one source ref or the output says cannot verify from current database."
    },
    {
      "gate_id": "form_existence",
      "label": "Form existence",
      "rule": "No court form draft unless form_id exists, template/source metadata was retrieved, and required fields are known."
    },
    {
      "gate_id": "authority_vs_precedent",
      "label": "Authority vs precedent separation",
      "rule": "If support comes only from firm precedent, label precedent-based not authority and run a separate authority lookup."
    },
    {
      "gate_id": "date_version_warning",
      "label": "Date/version warning",
      "rule": "If source lacks effective date or current-copy verification, add verify-current-version warning."
    },
    {
      "gate_id": "limitation_warning",
      "label": "Limitation warning",
      "rule": "Never give definitive limitation deadline without accident date, date of knowledge, disability/minor status and fatal accident status."
    },
    {
      "gate_id": "court_band_warning",
      "label": "Court band warning",
      "rule": "Court/forum output is preliminary routing only; verify current jurisdiction before filing."
    },
    {
      "gate_id": "contradiction_handling",
      "label": "Contradiction handling",
      "rule": "If high-trust sources conflict, show both and refuse a definitive conclusion unless the hierarchy resolves it."
    }
  ],
