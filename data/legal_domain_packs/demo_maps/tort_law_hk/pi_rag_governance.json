  "court_band_seed": {
    "source_id": "judiciary_district_court_civil",
    "title": "Preliminary court band guidance",
    "summary": "For PI routing only, tort claims over HK$75,000 and not more than HK$3 million should surface District Court as a preliminary candidate, claims above that band should surface CFI, and claims not exceeding HK$75,000 may surface Small Claims. Always verify current jurisdiction before filing.",
    "trigger_conditions": ["court", "forum", "jurisdiction", "claim value", "HK$75,000", "HK$3 million", "District Court", "CFI", "Small Claims"],
    "required_facts": ["estimated claim value", "claim type", "current jurisdiction limits", "filing strategy"],
    "warning": "Preliminary routing only; verify current jurisdiction and procedural rules before filing."
  },
  "acceptance_tests": [
    {
      "test_id": "no_source_no_answer",
      "query": "What is the limitation period for a HK personal injury claim?",
      "must_include": ["source citation", "accident date/date of knowledge caveat", "disability/minor caveat"],
      "must_not_include": ["definitive deadline without facts"]
    },
    {
      "test_id": "form_draft_requires_template",
      "query": "Draft a District Court writ for my PI case.",
      "must_do": ["retrieve dc_writ_form_1", "ask for missing plaintiff/defendant/accident/indorsement details", "refuse final form if template not loaded"]
    },
    {
