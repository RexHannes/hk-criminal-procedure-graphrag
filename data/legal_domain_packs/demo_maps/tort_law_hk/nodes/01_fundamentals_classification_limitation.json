      "id": "tort_meaning_scope",
      "doctrine_node_id": "tort_law_hk.fundamentals.meaning_scope",
      "type": "legal_issue",
      "label": "Meaning and Scope of Tort",
      "summary": "A tort is a civil wrong giving rise to a claim for damages or other remedy. Tort law governs private wrongs independent of contract. Multiple overlapping torts may arise from a single set of facts.",
