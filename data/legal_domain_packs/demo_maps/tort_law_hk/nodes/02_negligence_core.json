      "doctrine_node_id": "tort_law_hk.negligence.causation.but_for",
      "type": "legal_issue",
      "label": "Causation: But-For Test",
      "summary": "The defendant's breach must be a necessary condition of the harm: but for the breach, would the harm have occurred on the balance of probabilities?",
