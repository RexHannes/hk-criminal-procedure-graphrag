    {
      "id": "tort_negligence_remoteness",
      "doctrine_node_id": "tort_law_hk.negligence.remoteness",
      "type": "legal_issue",
      "label": "Remoteness of Damage",
      "summary": "Damage is too remote if it is not of a kind foreseeable as a possible outcome of the breach. The precise manner or full extent need not be foreseeable (Wagon Mound test).",
      "section": "02",
      "subsection": "02.04",
      "subtopic": "Remoteness",
      "source_basis": "book_seed",
