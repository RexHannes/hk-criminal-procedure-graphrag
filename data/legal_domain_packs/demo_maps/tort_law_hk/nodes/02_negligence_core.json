    {
      "id": "tort_negligence_thin_skull",
      "doctrine_node_id": "tort_law_hk.negligence.thin_skull",
      "type": "legal_issue",
      "label": "Thin Skull Rule",
      "summary": "The defendant must take the claimant as they find them. Vulnerability or pre-existing condition that exacerbates injury does not break causation (eggshell skull principle).",
      "section": "02",
      "subsection": "02.04",
      "subtopic": "Thin Skull",
