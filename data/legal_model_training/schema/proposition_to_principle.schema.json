{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hk_legal_model_training.proposition_to_principle.v1",
  "title": "Proposition To Principle SFT Example",
  "type": "object",
  "required": [
    "example_id",
    "task",
    "source_object_ids",
    "case_id",
    "case_name",
    "citation",
    "court",
    "judgment_date",
    "paragraph_ids",
    "source_urls",
    "exact_quote_support",
    "issue_tags",
    "answer_layer_status",
    "review_status",
    "usable_in_answer_layer",
    "demotion_reasons",
    "answer_safe",
    "input",
    "output",
    "provenance"
  ],
  "properties": {
    "example_id": { "type": "string" },
    "task": { "const": "proposition_to_principle" },
    "split": { "enum": ["train", "eval"] },
    "source_object_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "case_id": { "type": "string" },
    "case_name": { "type": "string" },
    "citation": { "type": "string" },
    "court": { "type": "string" },
    "judgment_date": { "type": "string" },
    "paragraph_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_urls": { "type": "array", "items": { "type": "string", "pattern": "^https://.*#p[0-9]+$" }, "minItems": 1 },
    "exact_quote_support": { "type": "string", "minLength": 8 },
    "issue_tags": { "type": "array", "items": { "type": "string" } },
    "answer_layer_status": { "const": "research_only" },
    "review_status": { "type": "string" },
    "usable_in_answer_layer": { "const": true },
    "demotion_reasons": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
    "answer_safe": { "const": false },
    "input": {
      "type": "object",
      "required": ["proposition_text", "exact_quote_support"],
      "properties": {
        "proposition_text": { "type": "string" },
        "exact_quote_support": { "type": "string" },
        "source_paragraph_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["principle_text", "liability_relevance", "limits", "distinguishable_when"],
      "properties": {
        "principle_text": { "type": "string" },
        "liability_relevance": { "enum": ["liability", "sentencing", "procedure", "background"] },
        "limits": { "type": "string" },
        "distinguishable_when": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source", "teacher_candidate", "verification_status"],
      "properties": {
        "source": { "type": "string" },
        "teacher_candidate": { "const": false },
        "verification_status": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "not": {
    "anyOf": [
      { "required": ["private_source_content"] },
      { "required": ["licensed_source_content"] },
      { "required": ["client_document_text"] },
      { "required": ["teacher_unverified_prose"] }
    ]
  },
  "additionalProperties": false
}
