# Server-side only. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct database URL for applying migrations with psql.
SUPABASE_DB_URL=

# Legal ingest storage. Keep service role/server-side only.
LEGAL_STORAGE_BACKEND=local
LEGAL_PRIVATE_BUCKET=legal-private-vault
LEGAL_PUBLIC_BUCKET=legal-public-sources
LEGAL_PARSED_BUCKET=legal-parsed-artifacts
LEGAL_REVIEW_ADMIN_TOKEN=
PUBLIC_DEMO_MODE=true
PRIVATE_SOURCE_INGESTION_ENABLED=false

# Runtime isolation for scale. Use development for local smoke; production_scale for 10k+ runs.
LEGAL_RUNTIME_MODE=development
# Auto-append _dev_localhash or _prod to Qdrant collection base names unless explicitly overridden.
LEGAL_QDRANT_NAMESPACE_AUTO=true

# Optional future vector backend.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PARAGRAPHS=hk_legal_paragraphs
QDRANT_COLLECTION_PROPOSITIONS=hk_proposition_cards
QDRANT_COLLECTION_FORMS=hk_form_metadata
QDRANT_COLLECTION_TEMPLATES=firm_private_templates
LEGAL_EMBEDDING_PROVIDER=local-hash
LEGAL_EMBEDDING_DIM=384
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
LEGAL_EMBEDDING_MODEL=
VOYAGE_API_KEY=
COHERE_API_KEY=
LEGAL_RERANK_PROVIDER=none
LEGAL_RERANK_MODEL=
RERANK_PROVIDER=none
RERANK_MODEL=
CASE_GRAPH_LLM_PROVIDER=none
# For production embeddings, prefer a real embedding model and matching dimension.
# LEGAL_EMBEDDING_PROVIDER=openai
# LEGAL_EMBEDDING_MODEL=text-embedding-3-small
# LEGAL_EMBEDDING_DIM=1536
# Or use a non-OpenAI stack:
# LEGAL_EMBEDDING_PROVIDER=voyage
# LEGAL_EMBEDDING_MODEL=voyage-3-large
# LEGAL_EMBEDDING_DIM=1024
# LEGAL_RERANK_PROVIDER=cohere
# LEGAL_RERANK_MODEL=rerank-v3.5

# Investor recall mode: bulk LegalRef case-level index for search demos (not answer-safe propositions).
# LEGAL_INVESTOR_RECALL_MODE=true
# QDRANT_COLLECTION_CASE_RECALL=hk_proposition_cards_openrouter_2048
# LEGAL_RETRIEVAL_ALLOWED_DOMAIN_IDS=criminal_procedure_hk,criminal_law_hk
# LEGAL_RETRIEVAL_PRACTICE_AREA=criminal_procedure
# LEGAL_RETRIEVAL_DOMAIN_LOCK=true
LLM_PROVIDER=none
# OpenRouter free stack (June 2026: openrouter.ai/collections/free-models)
OPENROUTER_FREE_ONLY=true
OPENROUTER_ALLOW_PAID=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_LOCAL_ENDPOINT=

# Optional GitHub Student Developer Pack integrations.
# Use for demos/public corpora unless private-source controls are reviewed.
LEGAL_INGEST_PUBLIC_BASE_URL=
DIGITALOCEAN_ACCESS_TOKEN=
DEMO_DOMAIN=

# Durable ingestion/workflow orchestration.
# Local dev can use INNGEST_DEV=1; production should use event/signing keys.
# Production 10k scale requires durable orchestration when LEGAL_RUNTIME_MODE=production_scale.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_EVENT_API_BASE=https://inn.gs/e

# Production-scale OpenRouter free stack (requires reindex into *_prod collections at 2048-dim):
# LEGAL_RUNTIME_MODE=production_scale
# LEGAL_OPENROUTER_ALLOWED_KEY_SUFFIX=11bb60
# OPENROUTER_FREE_ONLY=true
# OPENROUTER_ALLOW_PAID=false
# OPENROUTER_MODEL=openrouter/owl-alpha
# OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# OPENROUTER_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# LEGAL_EMBEDDING_PROVIDER=openrouter
# LEGAL_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# LEGAL_EMBEDDING_DIM=2048
# LEGAL_RERANK_PROVIDER=openrouter
# LEGAL_RERANK_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# OPENROUTER_API_KEY=   # designated free-tier key on Vercel Production only

# Choose one auth path when tenant/private-source access is implemented.
CLERK_ENABLED=false
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# Secret management / observability.
DOPPLER_PROJECT=
DOPPLER_CONFIG=
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
DATADOG_API_KEY=

# Optional Azure path.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
