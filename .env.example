# Server-side only. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: direct database URL for applying migrations with psql.
SUPABASE_DB_URL=

# Legal ingest storage. Keep service role/server-side only.
LEGAL_STORAGE_BACKEND=local
LEGAL_PRIVATE_BUCKET=legal-private-vault
LEGAL_PUBLIC_BUCKET=legal-public-sources
LEGAL_PARSED_BUCKET=legal-parsed-artifacts
LEGAL_REVIEW_ADMIN_TOKEN=

# Optional future vector backend.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PARAGRAPHS=hk_legal_paragraphs
QDRANT_COLLECTION_PROPOSITIONS=hk_proposition_cards
QDRANT_COLLECTION_FORMS=hk_form_metadata
QDRANT_COLLECTION_TEMPLATES=firm_private_templates
LEGAL_EMBEDDING_PROVIDER=local-hash
LEGAL_EMBEDDING_DIM=384
# For production embeddings, prefer a real embedding model and matching dimension.
# LEGAL_EMBEDDING_PROVIDER=openai
# LEGAL_EMBEDDING_MODEL=text-embedding-3-small
# LEGAL_EMBEDDING_DIM=1536

# Configure at least one AI provider for rerank/analysis.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
