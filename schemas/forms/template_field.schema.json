{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateField",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "fieldKey",
    "label",
    "required"
  ],
  "properties": {
    "fieldKey": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "valueType": {
      "type": "string"
    },
    "required": {
      "type": "boolean"
    },
    "placeholder": {
      "type": "string"
    },
    "evidenceRequired": {
      "type": "boolean"
    },
    "lawyerOnly": {
      "type": "boolean"
    }
  }
}
