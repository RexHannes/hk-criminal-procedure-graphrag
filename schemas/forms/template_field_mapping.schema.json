{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateFieldMapping",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "fieldKey",
    "matterPath",
    "status"
  ],
  "properties": {
    "fieldKey": {
      "type": "string"
    },
    "matterPath": {
      "type": "string"
    },
    "value": {},
    "status": {
      "type": "string"
    },
    "missingReason": {
      "type": "string"
    },
    "provenanceLabel": {
      "type": "string",
      "enum": [
        "SOURCE_BACKED",
        "TEMPLATE_BASED",
        "FIRM_SOP",
        "AI_SUGGESTED",
        "INTERNAL_USAGE_NOTE",
        "LAWYER_APPROVED"
      ]
    }
  }
}
