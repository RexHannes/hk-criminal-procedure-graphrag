{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/advice/crm_export_row.schema.json",
  "title": "CRM Export Row",
  "type": "object",
  "required": ["rowId", "part", "stage", "task", "owner", "dependencyIds", "status", "exportCategory"],
  "properties": {
    "rowId": { "type": "string" },
    "part": { "type": "string" },
    "stage": { "type": "string" },
    "task": { "type": "string" },
    "owner": { "type": "string" },
    "dueDate": { "type": ["string", "null"] },
    "dependencyIds": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" },
    "exportCategory": { "type": "string" },
    "documentIntent": { "type": "string" },
    "templateId": { "type": "string" },
    "privateTextCommitted": { "const": false }
  }
}
